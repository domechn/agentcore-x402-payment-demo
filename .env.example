# 复制为 .env 后填写。这些是 Privy + AgentCore Payments 主流程用到的变量。

WALLET_EMAIL=            # 你的邮箱，用来在 Privy 前端登录并给 agent 授权（setup_payments.py 第 4 步）
SELLER_ADDRESS=          # 卖家收款地址，任意一个你自己的 EVM 地址；不要用 agent 钱包地址

# 以下来自 Privy Dashboard（dashboard.privy.io）新建的专用 app：
PRIVY_APP_ID=                    # Settings → API keys 里的 App ID
PRIVY_APP_SECRET=                # Settings → API keys 里的 App secret
PRIVY_AUTHORIZATION_ID=          # Wallet infrastructure → Authorization 新建 key 后的 Key ID
PRIVY_AUTHORIZATION_PRIVATE_KEY= # 对应的私钥，带不带 wallet-auth: 前缀都行
