# Copy to .env and fill in. These are the variables used by the main flow (Privy + AgentCore Payments).

WALLET_EMAIL=            # Your email, used to log in to the Privy frontend and grant the agent access (setup_payments.py step 4)
SELLER_ADDRESS=          # Seller payout address, any EVM address you own; do NOT use the agent wallet address

# The following come from a dedicated app you create in the Privy Dashboard (dashboard.privy.io):
PRIVY_APP_ID=                    # App ID from Settings -> API keys
PRIVY_APP_SECRET=                # App secret from Settings -> API keys
PRIVY_AUTHORIZATION_ID=          # Key ID from Wallet infrastructure -> Authorization -> New key
PRIVY_AUTHORIZATION_PRIVATE_KEY= # The matching private key; with or without the wallet-auth: prefix is fine
